{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soundhood",
  "version": "0.3.0",
  "identifier": "com.mgmat.soundhood",
  "build": {
    "beforeDevCommand": "npm run build:tools && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:tools && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Soundhood",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "backgroundColor": "#0f0f0f",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,msOneAuthWAM --autoplay-policy=no-user-gesture-required --disable-background-networking --disable-component-update --no-proxy-server"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
  "active": true,
  "targets": "all",
  "icon": [
    "icons/32x32.png",
    "icons/128x128.png",
    "icons/128x128@2x.png",
    "icons/icon.icns",
    "icons/icon.ico"
  ],
  "externalBin": [
    "bin/yt-dlp",
    "bin/deno",
    "bin/soundhood-tools"
  ]
}
}
