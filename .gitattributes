# Text files: git decides and stores LF in the repository. Every text file in the index is LF
# already, so this adds no line-ending churn; do not run `git add --renormalize`.
* text=auto

# Scripts whose interpreter cares about line endings.
gradlew text eol=lf
*.sh    text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Audio (core/fixtures, fixture libraries)
*.flac  binary
*.m4a   binary
*.mp3   binary
*.ogg   binary
*.opus  binary
*.wav   binary
*.aac   binary

# Images, icons, fonts (icons, screenshot baselines, docs/evidence)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.woff  binary
*.woff2 binary
*.ttf   binary

# Java / Android / native artefacts
*.jar   binary
*.aar   binary
*.so    binary
*.dll   binary
*.exe   binary
*.zip   binary
